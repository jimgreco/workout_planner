# ── Dev login bypass ───────────────────────────────────────────────────────────
# Set to true to skip Google sign-in and use a mock "Dev User" account.
# The backend also accepts the bypass token only when LOCAL_AUTH_BYPASS=true.
# Never set this in production — VITE_ vars are baked in at build time, and the
# production backend runs with LOCAL_AUTH_BYPASS=false.
VITE_DEV_BYPASS_AUTH=true
LOCAL_AUTH_BYPASS=true

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Create at https://console.cloud.google.com/ → APIs & Services → Credentials
# → Create credentials → OAuth 2.0 Client ID → Web application.
# Add http://localhost:5173 and your CloudFront domain to Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Backend token verification. For Docker/local API deployments, set the web
# client ID here and optionally include the iOS client ID in GOOGLE_CLIENT_IDS.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=your-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com

# Sign in with Apple token verification. For the native iOS app, use the app's
# bundle ID unless you later add an Apple Services ID for web auth.
APPLE_CLIENT_IDS=com.workoutplanner.ios

# 32+ character secret used to sign 30-day app session tokens after Google/Apple
# credentials are verified. Required in production.
APP_SESSION_SECRET=replace-with-at-least-32-random-characters

# ── Backend API ────────────────────────────────────────────────────────────────
# Web API base URL. Use http://localhost:3001 when running Vite against
# backend/local-server.mjs, or /api for the Docker/Nginx production shape.
VITE_API_URL=http://localhost:3001

# Comma-separated browser origins accepted by backend/local-server.mjs.
ALLOWED_ORIGINS=http://localhost:5173,https://workout-planner.jim-greco.com
RATE_LIMIT_PER_MINUTE=120

# Release metadata returned by GET /version and shown in support traces.
APP_VERSION=1.0.0
GIT_COMMIT=local
BUILD_TIME=local

# Optional backup/recovery settings used by `cd backend && npm run recovery:check`.
USE_AWS=false
BACKUP_DIR=../backups

# ── Native iOS app ────────────────────────────────────────────────────────────
# The SwiftUI iPhone app lives in ios/. Configure its API URL and iOS OAuth
# client ID in ios/project.yml, then run `cd ios && xcodegen generate`.
# When deploying the backend, include the iOS OAuth client ID in GOOGLE_CLIENT_IDS
# and the iOS bundle ID in APPLE_CLIENT_IDS so native ID tokens verify.
