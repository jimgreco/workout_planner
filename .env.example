# ── Dev login bypass ───────────────────────────────────────────────────────────
# Set to true to skip Google sign-in and use a mock "Dev User" account.
# The backend also accepts the bypass token when running via `sam local start-api`.
# Never set this in production — it has no effect there (VITE_ vars are baked in
# at build time, and AWS_SAM_LOCAL is never true on real Lambda).
VITE_DEV_BYPASS_AUTH=true

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Create at https://console.cloud.google.com/ → APIs & Services → Credentials
# → Create credentials → OAuth 2.0 Client ID → Web application.
# Add http://localhost:5173 and your CloudFront domain to Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Backend token verification. For Docker/local API deployments, set the web
# client ID here and optionally include the iOS client ID in GOOGLE_CLIENT_IDS.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=your-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com

# Sign in with Apple token verification. For the native iOS app, use the app's
# bundle ID unless you later add an Apple Services ID for web auth.
APPLE_CLIENT_IDS=com.workoutplanner.ios

# ── Backend API ────────────────────────────────────────────────────────────────
# Base URL for the API Gateway HTTP API deployed by SAM.
# In CI, this is captured automatically from CloudFormation stack outputs.
# For local dev, deploy the backend once and paste the URL here:
#   sam deploy --template backend/template.yaml ...
#   aws cloudformation describe-stacks --stack-name workout-planner-backend \
#     --query "Stacks[0].Outputs[?OutputKey=='ApiUrl'].OutputValue" --output text
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# ── Native iOS app ────────────────────────────────────────────────────────────
# The SwiftUI iPhone app lives in ios/. Configure its API URL and iOS OAuth
# client ID in ios/project.yml, then run `cd ios && xcodegen generate`.
# When deploying the backend, pass the iOS OAuth client ID through the optional
# SAM parameter `GoogleClientIds` and the iOS bundle ID through `AppleClientIds`
# so Lambda accepts both Google and Apple native tokens.
